<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
 xmlns:app="http://schemas.android.com/apk/res-auto"
 android:orientation="vertical" android:layout_width="match_parent"
 android:layout_height="match_parent" android:fitsSystemWindows="true"
 android:padding="8dp">
 <TextView android:id="@+id/gguf" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:textSize="14sp"
  android:padding="12dp" android:text="Williams AI • загрузка…" />
 <Button android:id="@+id/book_button" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:text="📚 Загрузить личную библиотеку Вильямса (SQLite)" />
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <Spinner android:id="@+id/study_edition" android:layout_width="90dp"
   android:layout_height="48dp" android:contentDescription="Издание для изучения" />
  <Button android:id="@+id/study_button" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="wrap_content"
   android:enabled="false" android:text="Изучать выбранную книгу" />
 </LinearLayout>
 <!-- PRIVATE local market history: user-tapped Binance PUBLIC USD-M GET only. -->
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <Button android:id="@+id/market_start" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="wrap_content"
   android:text="📈 Загрузить 15 ТФ" android:textSize="12sp" />
  <Button android:id="@+id/market_stop" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="wrap_content"
   android:text="⏹ Стоп" android:textSize="12sp" />
  <Button android:id="@+id/market_refresh" android:layout_width="0dp"
   android:layout_weight="1" android:layout_height="wrap_content"
   android:text="Статус" android:textSize="12sp" />
 </LinearLayout>
 <TextView android:id="@+id/market_status" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:padding="6dp" android:textSize="12sp"
  android:maxLines="3" android:text="Binance история: не загружена. Только публичные свечи, сделок нет." />
 <CheckBox android:id="@+id/web_enabled" android:layout_width="match_parent"
  android:layout_height="wrap_content" android:checked="false"
  android:text="🌐 Искать в интернете, когда информации недостаточно (отправляется только мой вопрос)"
  android:textSize="13sp" />
 <androidx.recyclerview.widget.RecyclerView android:id="@+id/messages"
  android:layout_width="match_parent" android:layout_height="0dp"
  android:layout_weight="1" android:scrollbars="vertical" />
 <LinearLayout android:orientation="horizontal" android:layout_width="match_parent"
  android:layout_height="wrap_content">
  <EditText android:id="@+id/user_input" android:layout_width="0dp"
   android:layout_height="wrap_content" android:layout_weight="1"
   android:enabled="false" android:maxLines="3" android:hint="Введите вопрос" />
  <com.google.android.material.floatingactionbutton.FloatingActionButton
   android:id="@+id/fab" android:layout_width="wrap_content"
   android:layout_height="wrap_content" android:layout_margin="6dp"
   android:src="@drawable/outline_folder_open_24" />
 </LinearLayout>
</LinearLayout>
